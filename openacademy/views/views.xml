      <field name="code">
        action = {
          "type": "ir.actions.act_window",
          "view_mode": "list,form",
          "res_model": model._name,
        }
      </field>
    </record>
-->

    <!-- Top menu item -->
    <menuitem name="Openacademy SGE" id="openacademy.menu_root"/>

    <!-- menu categories -->

    <menuitem name="Incidencias" id="openacademy_incidencias" parent="openacademy.menu_root"/>
    <!--
    <menuitem name="Menu 2" id="openacademy.menu_2" parent="openacademy.menu_root"/>
    -->

    <!-- actions -->
    <menuitem name="Mostrar lista" id="incidencia_list" parent="openacademy_incidencias"
              action="incidencia.action_window"/>
<!--    <menuitem name="Server to list" id="openacademy" parent="openacademy.menu_2"
              action="openacademy.action_server"/>
-->
  </data>
</odoo>
